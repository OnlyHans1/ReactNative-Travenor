{
  "expo": {
    "name": "travenor",
    "slug": "travenor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon/logo.svg",
    "scheme": "travenor",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1B1E28",
          "dark": {
            "backgroundColor": "#0D0E12"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
